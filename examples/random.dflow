triggers
  Intent festival
    "I want to go to the festival",
    "Tell me where the festival is please",
    "I want to tell me the headlines of the festival for" PE:GPE['Thessaloniki', 'Athens']
  end

  Intent greet
    "hey",
    "hello",
    "hi",
    "hello there",
    "good morning",
    "good evening",
    "moin",
    "hey there",
    "let's go",
    "hey dude",
    "goodmorning",
    "goodevening",
    "good afternoon"
  end

  Intent bot_challenge
    "are you a bot?",
    "are you listening?",
    "am I talking to a bot?",
    "am I talking to a human?",
    "bot there?"
  end
end

eservices
    EServiceHTTP weather_svc
        verb: GET
        host: 'http://services.issel.ee.auth.gr'
        path: '/general_information/weather_openweather'
    end
end

dialogues
  Dialogue festival_dialogue
      on: festival
      responses:
        Form form1
          city_slot: str = HRI('For which city?', [PE:GPE])
          answer: str = weather_svc(query=[city=form1.city_slot, language="English"], header=[access_token="Q5eJZ8sSLEX6XNmOHyMlWagI"],)[description]
        end,
        ActionGroup answer_back
          Speak('The weather forecast for' form1.city_slot ' is ' form1.answer)
        end
  end

  Dialogue greet_dialogue
      on: greet
      responses:
        ActionGroup greet_back
          Speak('Hey there!!!')
        end
  end

  Dialogue bot_challenge_dialogue
      on: bot_challenge
      responses:
        ActionGroup respond_iambot
          Speak('I am a bot, powered by dFlow and Rasa.')
        end
  end


end
